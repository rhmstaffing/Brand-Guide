# ---- Required ----
# Public URL of the site. QR codes and card links are built from this.
APP_URL=https://cards.rhmstaffing.net
DATABASE_URL=postgresql://user:pass@host:5432/rhmcards
# Long random string. Run: openssl rand -base64 48
AUTH_SECRET=
# People who get full admin access on login (comma separated)
ADMIN_EMAILS=marketing@rhmstaffing.net

# ---- Login code emails (Office 365 / Google Workspace SMTP) ----
# Without these, codes are printed to the server log (dev only).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=no-reply@rhmstaffing.net
SMTP_PASS=
EMAIL_FROM=RHM Cards <no-reply@rhmstaffing.net>

# ---- QR Code Monkey ----
# Works without a key on the free API. For higher volume, use the RapidAPI plan.
QR_MONKEY_RAPIDAPI_KEY=
# Optional public URL of the center logo. Defaults to public/brand/qr-logo.png (uploaded automatically).
QR_LOGO_URL=

# ---- Salesforce (External Client App with Client Credentials flow) ----
SF_LOGIN_URL=https://rhmstaffing.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Used to build "Open in Salesforce" links
SF_INSTANCE_URL=https://rhmstaffing.lightning.force.com
# Object to create: Lead (default) or Contact. Can be split by type.
SF_OBJECT=Lead
SF_OBJECT_CANDIDATE=
SF_OBJECT_CLIENT=
SF_LEAD_SOURCE=Digital Business Card
SF_API_VERSION=v62.0

# ---- Document scanning (text + handwriting) ----
ANTHROPIC_API_KEY=
OCR_MODEL=claude-opus-5-5

# ---- Apple Wallet ----
APPLE_PASS_TYPE_ID=pass.net.rhmstaffing.cards
APPLE_TEAM_ID=
# base64 of each PEM file: base64 -w0 wwdr.pem
APPLE_WWDR_PEM_B64=
APPLE_SIGNER_CERT_PEM_B64=
APPLE_SIGNER_KEY_PEM_B64=
APPLE_SIGNER_KEY_PASSPHRASE=

# ---- Google Wallet (Android) ----
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
# base64 of the service account private_key (PEM, PKCS8)
GOOGLE_WALLET_SA_KEY_B64=
